# Copy this file to .env and fill in real values. Do NOT commit .env.

# Admin dashboard password — required for /admin (fail closed if unset).
ADMIN_PASSWORD=change-me

# Anthropic API key for the Chefo chatbot. Optional locally; the chatbot is
# disabled (shows a WhatsApp fallback) when empty.
ANTHROPIC_API_KEY=

# Gmail App Password used by daily_summary.py to email the owner. Optional.
SUMMARY_EMAIL_PASS=
